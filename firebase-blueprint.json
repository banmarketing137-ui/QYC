{
  "entities": {
    "ProjectSettings": {
      "title": "ProjectSettings",
      "description": "Global project configuration and CMS content for Quang Yen Centro",
      "type": "object",
      "properties": {
        "data": { "type": "object", "description": "Complete ProjectData JSON" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" },
        "updatedBy": { "type": "string", "description": "Modifier label" }
      },
      "required": ["data", "updatedAt"]
    },
    "Consultation": {
      "title": "Consultation",
      "description": "Customer consultation and policy registrations",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["phone", "createdAt"]
    }
  },
  "firestore": {
    "/project_settings/{settingId}": {
      "schema": "ProjectSettings",
      "description": "CMS and live project content"
    },
    "/consultations/{consultationId}": {
      "schema": "Consultation",
      "description": "Customer contact leads"
    }
  }
}
